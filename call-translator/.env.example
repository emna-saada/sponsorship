# Copy this file to .env to change settings. Everything works with the defaults.

# Translation engine:
#   local  = free, offline NLLB-200 model on your PC (default, no account needed)
#   claude = Anthropic Claude API (paid; needs ANTHROPIC_API_KEY below)
TRANSLATOR=local
# Local model: 600M is fast; 1.3B is a bit more accurate but ~2x slower on CPU
NLLB_MODEL=osa911/nllb-200-distilled-600M-ct2-int8
# NLLB_MODEL=OpenNMT/nllb-200-distilled-1.3B-ct2-int8

# Only for TRANSLATOR=claude. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Whisper model: small (fast, default) or medium (more accurate, slower)
WHISPER_MODEL=small
# auto = CUDA GPU if available, otherwise CPU int8. Or force: cuda | cpu
WHISPER_DEVICE=auto

# Segmenting: pause length that ends a sentence, and maximum segment length
SILENCE_MS=600
MAX_SEGMENT_S=10
# Silero VAD speech threshold (raise to 0.6-0.7 if background noise triggers it)
VAD_THRESHOLD=0.5

PORT=8000
