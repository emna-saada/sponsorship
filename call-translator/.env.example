# Copy this file to .env to change settings. Everything works with the defaults.

# Translation engine:
#   local  = free, offline NLLB-200 model on your PC (default, no account needed)
#   claude = Anthropic Claude API (paid; needs ANTHROPIC_API_KEY below)
TRANSLATOR=local
# Local model. auto = 1.3B on an NVIDIA GPU (more accurate), 600M on CPU (faster).
# Or force one: OpenNMT/nllb-200-distilled-1.3B-ct2-int8 | osa911/nllb-200-distilled-600M-ct2-int8
NLLB_MODEL=auto

# Only for TRANSLATOR=claude. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Speech model. auto = large-v3-turbo on an NVIDIA GPU (much more accurate), small on CPU.
# Or force one: small | medium | large-v3-turbo
WHISPER_MODEL=auto
# auto = CUDA GPU if available, otherwise CPU int8. Or force: cuda | cpu
WHISPER_DEVICE=auto

# Segmenting: pause length that ends a sentence, and maximum segment length
SILENCE_MS=600
MAX_SEGMENT_S=10
# Silero VAD speech threshold (raise to 0.6-0.7 if background noise triggers it)
VAD_THRESHOLD=0.5

# CPU threads per model (default: half your logical cores, min 4)
# CPU_THREADS=4

PORT=8000
